{
  "name": "janardhan-stores-static-site",
  "version": "1.0.0",
  "private": true,
  "description": "Janardhan General Stores and Puja Samagri public catalogue — fully static site for Cloudflare Pages. Independent of the main app.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs",
    "images": "node scripts/fetch-images.mjs && node scripts/make-thumbs.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:quick": "node scripts/verify.mjs --quick",
    "shop-photos": "node scripts/import-shop-photos.mjs",
    "editor": "node editor/run.mjs",
    "local": "node scripts/open-local.mjs",
    "brand-assets": "node scripts/make-brand-assets.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.48.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.33.5"
  }
}
